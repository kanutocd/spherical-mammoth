{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spherical-mammoth.local/contracts/events/identity.verification_requested.v1.schema.json",
  "title": "Identity Verification Requested v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "data"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "const": "identity.verification_requested" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signup_request_id", "identity_id", "email"],
      "properties": {
        "signup_request_id": { "type": "string", "minLength": 1 },
        "identity_id": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "display_name": { "type": ["string", "null"] },
        "verification_url": { "type": ["string", "null"], "format": "uri" }
      }
    }
  }
}
