aws_region        = "ap-southeast-1"
environment       = "dev"
availability_zone = "ap-southeast-1a"

# Output from packer build in ../packer.
ami_id        = "ami-0123456789abcdef0"
instance_type = "t3.micro"

vpc_cidr            = "10.60.0.0/24"
private_subnet_cidr = "10.60.0.0/26"

root_volume_size_gib = 8
data_volume_size_gib = 22

operator_principal_arns = [
  "arn:aws:iam::123456789012:role/platform-operator",
]
