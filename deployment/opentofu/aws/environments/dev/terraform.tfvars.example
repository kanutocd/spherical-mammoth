aws_region  = "ap-southeast-1"
environment = "dev"
vpc_cidr    = "10.40.0.0/16"

single_nat_gateway          = true
cluster_public_access       = true
cluster_public_access_cidrs = ["203.0.113.10/32"]
cluster_admin_principal_arns = ["arn:aws:iam::123456789012:role/platform-admin"]
node_instance_types         = ["t3.medium"]
node_capacity_type          = "SPOT"
node_min_size               = 1
node_desired_size           = 2
node_max_size               = 4

postgres_instance_class      = "db.t4g.micro"
postgres_multi_az            = false
postgres_deletion_protection = false
postgres_skip_final_snapshot = true
