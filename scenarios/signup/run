#!/usr/bin/env bash
set -euo pipefail

bridge_url="${BRIDGE_URL:-http://localhost:8081}"
mailpit_url="${MAILPIT_URL:-http://localhost:8025}"
run_id="$(date +%s)-$$"
identity_id="scenario-${run_id}"
email="${identity_id}@spherical-mammoth.test"
before="$(curl --fail --silent --show-error "${mailpit_url}/api/v1/messages" | python3 -c 'import json,sys; print(json.load(sys.stdin)["total"])')"

curl --fail --silent --show-error \
  --request POST "${bridge_url}/v1/lifecycle/verification-requested" \
  --header 'Content-Type: application/json' \
  --data "{\"identity_id\":\"${identity_id}\",\"email\":\"${email}\",\"display_name\":\"Scenario User\"}" \
  >/dev/null

deadline=$((SECONDS + 30))
while (( SECONDS < deadline )); do
  after="$(curl --fail --silent --show-error "${mailpit_url}/api/v1/messages" | python3 -c 'import json,sys; print(json.load(sys.stdin)["total"])')"
  if test "$after" -eq "$((before + 1))"; then
    echo "signup lifecycle smoke passed: PostgreSQL -> Mammoth -> email sink -> Mailpit"
    exit 0
  fi
  sleep 1
done

echo "timed out waiting for Mammoth delivery" >&2
exit 1
